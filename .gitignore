tools/venv/
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

# Sanskar's theme pictures stay on this Mac only (artwork: wallpaper, app logos, TMDB characters, mood deck posters, slideshow).
# config.json and README.md in themes/sanskar are kept in git.
themes/sanskar/wallpaper/
themes/sanskar/logos/
themes/sanskar/watchlist/
themes/sanskar/moods/
themes/sanskar/screensaver/
themes/sanskar/screenshot-tv.jpg
# His own font files stay here too, in any theme.
themes/*/fonts/
themes/**/*.ttf
themes/**/*.otf
themes/sanskar/**/*.png
themes/sanskar/**/*.jpg
themes/sanskar/**/*.jpeg
themes/sanskar/**/*.webp
# ...except the theme's screenshot, which is a stand-in without artwork (the real one is screenshot-tv.jpg).
!themes/sanskar/screenshot.jpg
# The TV screenshots of that theme that used to illustrate docs/switches.md are in work/switch-shots-tv/ (ignored);
# docs/switches.md shows stand-ins from the preview emulator instead.

# Private files that must never reach the public repository.
.env
.env.*
adbkey
adbkey.pub
tmdb-auth.json
/data/
themes/sanskar/config.json
themes/sanskar/effects.json
